
-- Renames target_date -> date and value -> follower_count, and splits the API's generic
-- breakdown/dimension_value pair into one typed column per category (age_group, gender,
-- country_code, city) plus a country_name resolved via lookup_country_code_mapping.
--
-- The grain stays one row per dimension value, so only one category column is populated on each
-- row and the rest are NULL. This is deliberately not a column per dimension *value*: age and
-- gender have stable closed vocabularies, but city and country only return the top ~45 per pull and
-- that set churns (46 distinct values across the first 5 days), so a column per value would mean
-- the table's schema changing whenever a city enters or leaves the top 45.
--
-- The category columns are generated from threadsDemographicBreakdowns in includes/constants.js, so
-- a new breakdown becomes a column by adding one entry there. breakdown and dimension_value are
-- kept alongside the typed columns: they are the grain, they feed the surrogate key downstream, and
-- they still carry the value of an unrecognised breakdown that has no typed column yet.
config {
  type: "table",
  tags: ["staging"],
  assertions: {
    uniqueKey: ["threads_user_id", "date", "breakdown", "dimension_value"],
    nonNull: ["threads_user_id", "date", "breakdown", "dimension_value"],
    rowConditions: []
  },
  columns: {
    threads_user_id: "The Threads user ID",
    date: "YYYY-MM-DD date of this snapshot",
    breakdown: "The demographic dimension this row breaks followers down by: age, city, country or gender",
    dimension_value: "The raw value within the breakdown, e.g. 25-34 for age, F for gender, an ISO country code for country",
    age_group: "The age band this row covers, e.g. 25-34; NULL unless breakdown is age",
    gender: "The gender this row covers, as the raw API code F, M or U; NULL unless breakdown is gender",
    country_code: "The ISO country code this row covers; NULL unless breakdown is country",
    city: "The city this row covers, e.g. 'London, England'; NULL unless breakdown is city",
    country_name: "The country name for country_code, via lookup_country_code_mapping; NULL unless breakdown is country. Listed after city because the category columns are generated in breakdown order",
    follower_count: "The cumulative number of followers in this dimension_value as at the snapshot date"
  }
}

js {
  const { ifConditionValue } = require('includes/utils');
  const { threadsDemographicBreakdowns } = require('includes/constants');
}

SELECT
  d.threads_user_id,
  d.target_date AS date,
  d.breakdown,
  d.dimension_value,
  ${threadsDemographicBreakdowns.map(
    breakdown => ifConditionValue('d.breakdown', breakdown.breakdown, 'd.dimension_value', breakdown.column)
  ).join(',\n  ')},
  c.country AS country_name,
  d.value AS follower_count
FROM ${ref("raw_threads_follower_demographics")} d
LEFT JOIN ${ref("lookup_country_code_mapping")} c
  ON d.breakdown = 'country'
  AND d.dimension_value = c.country_code
