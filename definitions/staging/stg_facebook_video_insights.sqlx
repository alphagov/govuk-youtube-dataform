
-- Pivots the EAV-shaped facebook_video_insights raw table into one row per
-- (video_id, date), with each distinct metric as its own column, using
-- conditional aggregation (MAX(IF(...))). period is always 'lifetime' today
-- (lifetime totals as of this target_date snapshot); filtered defensively so
-- a future new period value can't silently collide inside MAX(IF(...)).
config {
  type: "table",
  tags: ["staging"],
  assertions: {
    uniqueKey: ["video_id", "date"],
    nonNull: ["video_id", "date"],
    rowConditions: []
  },
  columns: {
    video_id: "The Facebook video ID",
    date: "YYYY-MM-DD date of this insights snapshot",
    blue_reels_play_count: "Number of plays of the video as a Facebook Reel",
    fb_reels_replay_count: "Number of replays of the video as a Facebook Reel",
    fb_reels_total_plays: "Total plays of the video as a Facebook Reel",
    post_impressions_unique: "Number of unique people who saw the post containing this video",
    post_video_avg_time_watched: "Average time watched for the video (unit unconfirmed)",
    post_video_followers: "Number of page followers who watched the video",
    post_video_view_time: "Total time spent watching the video (unit unconfirmed)"
  }
}

SELECT
  video_id,
  target_date AS date,
  MAX(IF(metric = 'blue_reels_play_count', value, NULL))       AS blue_reels_play_count,
  MAX(IF(metric = 'fb_reels_replay_count', value, NULL))       AS fb_reels_replay_count,
  MAX(IF(metric = 'fb_reels_total_plays', value, NULL))        AS fb_reels_total_plays,
  MAX(IF(metric = 'post_impressions_unique', value, NULL))     AS post_impressions_unique,
  MAX(IF(metric = 'post_video_avg_time_watched', value, NULL)) AS post_video_avg_time_watched,
  MAX(IF(metric = 'post_video_followers', value, NULL))        AS post_video_followers,
  MAX(IF(metric = 'post_video_view_time', value, NULL))        AS post_video_view_time
FROM ${ref("raw_facebook_video_insights")}
WHERE period = 'lifetime'
GROUP BY video_id, target_date
