
-- Renames target_date -> date and passes through the Facebook page metadata snapshot.
config {
  type: "table",
  tags: ["staging"],
  assertions: {
    uniqueKey: ["page_id", "date"],
    nonNull: ["page_id", "date"],
    rowConditions: []
  },
  columns: {
    page_id: "The Facebook page ID",
    date: "YYYY-MM-DD date of this metadata snapshot",
    name: "The name of the page",
    fan_count: "The number of people who like the page",
    followers_count: "The number of people who follow the page",
    talking_about_count: "The number of people talking about the page"
  }
}

SELECT
  page_id,
  target_date AS date,
  name,
  fan_count,
  followers_count,
  talking_about_count
FROM ${ref("raw_facebook_page_info")}
