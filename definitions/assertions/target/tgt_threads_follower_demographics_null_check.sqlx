config {
  type: "assertion",
  description: "Fails if required fields are NULL in tgt_threads_follower_demographics"
}

SELECT
  *
FROM ${ref("tgt_threads_follower_demographics")}
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
  AND (
    date IS NULL
    OR threads_user_id IS NULL
    OR breakdown IS NULL
    OR dimension_value IS NULL
  )
