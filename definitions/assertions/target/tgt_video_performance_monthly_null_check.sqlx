config {
  type: "assertion",
  description: "Fails if required fields are NULL in tgt_video_performance_monthly"
}

SELECT
  *
FROM ${ref("tgt_video_performance_monthly")}
WHERE (month >= DATE('1900-01-01') OR month IS NULL)
  AND (
    video_id IS NULL
    OR month IS NULL
    OR data_source IS NULL
    OR views IS NULL
  )
