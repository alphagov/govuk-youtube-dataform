config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, threads_user_id, breakdown, dimension_value)"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY date, threads_user_id, breakdown, dimension_value
  ) AS duplicate_count
FROM ${ref("tgt_threads_follower_demographics")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
