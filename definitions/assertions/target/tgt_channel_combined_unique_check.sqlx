config {
  type: "assertion",
  description: "Fails if duplicate rows exist for tgt_channel_combined unique key"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY
      date,
      channel_id,
      video_id,
      live_or_on_demand,
      subscribed_status,
      playback_location_type,
      traffic_source_type,
      device_type,
      operating_system
  ) AS duplicate_count
FROM ${ref("tgt_channel_combined")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
