config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, reply_id)"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY date, reply_id
  ) AS duplicate_count
FROM ${ref("tgt_threads_replies_combined")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
