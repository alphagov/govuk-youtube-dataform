config {
  type: "assertion",
  description: "Fails if required fields are NULL in tgt_video_by_device_os"
}

SELECT
  *
FROM ${ref("tgt_video_by_device_os")}
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
  AND (
    date IS NULL
    OR video_id IS NULL
    OR device_type_name IS NULL
    OR operating_system_name IS NULL
    OR data_source IS NULL
    OR views IS NULL
  )
