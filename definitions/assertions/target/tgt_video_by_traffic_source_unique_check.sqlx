config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, video_id, traffic_source_type_name)"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY date, video_id, traffic_source_type_name
  ) AS duplicate_count
FROM ${ref("tgt_video_by_traffic_source")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
