config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, video_id, traffic_source_type_name)"
}

WITH duplicate_keys AS (
  SELECT
    date,
    video_id,
    traffic_source_type_name,
    COUNT(*) AS duplicate_count
  FROM ${ref("tgt_video_by_traffic_source")}
  WHERE (date >= DATE('1900-01-01') OR date IS NULL)
  GROUP BY date, video_id, traffic_source_type_name
  HAVING COUNT(*) > 1
)
SELECT
  t.*,
  d.duplicate_count
FROM ${ref("tgt_video_by_traffic_source")} t
JOIN duplicate_keys d USING (date, video_id, traffic_source_type_name)
WHERE (t.date >= DATE('1900-01-01') OR t.date IS NULL)
