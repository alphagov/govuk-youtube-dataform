config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, video_id)"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY date, video_id
  ) AS duplicate_count
FROM ${ref("tgt_facebook_video_performance_daily")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
