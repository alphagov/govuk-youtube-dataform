config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, video_id, device_type_name, operating_system_name)"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY date, video_id, device_type_name, operating_system_name
  ) AS duplicate_count
FROM ${ref("tgt_video_by_device_os")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
