config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, video_id, content_type)"
}

SELECT
  t.*,
  COUNT(*) OVER (
    PARTITION BY date, video_id, content_type
  ) AS duplicate_count
FROM ${ref("tgt_video_by_content_type")} t
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
QUALIFY duplicate_count > 1
