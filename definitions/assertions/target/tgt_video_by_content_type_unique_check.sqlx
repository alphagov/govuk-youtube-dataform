config {
  type: "assertion",
  description: "Fails if duplicate rows exist for (date, video_id, content_type)"
}

WITH duplicate_keys AS (
  SELECT
    date,
    video_id,
    content_type,
    COUNT(*) AS duplicate_count
  FROM ${ref("tgt_video_by_content_type")}
  WHERE (date >= DATE('1900-01-01') OR date IS NULL)
  GROUP BY date, video_id, content_type
  HAVING COUNT(*) > 1
)
SELECT
  t.*,
  d.duplicate_count
FROM ${ref("tgt_video_by_content_type")} t
JOIN duplicate_keys d USING (date, video_id, content_type)
WHERE (t.date >= DATE('1900-01-01') OR t.date IS NULL)
