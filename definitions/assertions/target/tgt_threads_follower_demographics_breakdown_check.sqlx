config {
  type: "assertion",
  description: "Fails if the Threads API returns a follower demographics breakdown with no typed column"
}

js {
  const { threadsDemographicBreakdowns } = require('includes/constants');
}

SELECT DISTINCT
  breakdown
FROM ${ref("tgt_threads_follower_demographics")}
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
  AND breakdown NOT IN (${threadsDemographicBreakdowns.map(breakdown => `'${breakdown.breakdown}'`).join(', ')})
