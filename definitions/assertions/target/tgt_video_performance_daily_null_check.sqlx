config {
  type: "assertion",
  description: "Fails if required fields are NULL in tgt_video_performance_daily"
}

SELECT
  *
FROM ${ref("tgt_video_performance_daily")}
WHERE (date >= DATE('1900-01-01') OR date IS NULL)
  AND (
    date IS NULL
    OR video_id IS NULL
    OR data_source IS NULL
    OR views IS NULL
  )
