
-- A table that contains the raw Facebook video insights (lifetime metrics, EAV shape)
config {
  type: "view",
  tags: ["raw"],
  assertions: {
    uniqueKey: ["video_id", "target_date", "metric", "period"],
    nonNull: ["video_id", "target_date", "metric", "period"],
    rowConditions: []
  },
  columns: {
    video_id: "The Facebook video ID",
    metric: "The name of the insight metric, e.g. blue_reels_play_count, fb_reels_total_plays",
    period: "The aggregation period the metric value applies to (currently always 'lifetime')",
    value: "The numeric value of the metric",
    target_date: "YYYY-MM-DD date of this insights snapshot",
    ingestion_timestamp: "The timestamp this row was ingested into BigQuery"
  }
}

SELECT
  CAST(video_id AS STRING) AS video_id,
  CAST(metric AS STRING) AS metric,
  CAST(period AS STRING) AS period,
  CAST(value AS INT64) AS value,
  CAST(target_date AS DATE) AS target_date,
  CAST(ingestion_timestamp AS TIMESTAMP) AS ingestion_timestamp
FROM
  `gds-social-data.govuk_facebook.facebook_video_insights`
WHERE video_id IS NOT NULL
