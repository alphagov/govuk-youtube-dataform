
-- A table that contains the raw Facebook post insights (lifetime metrics, EAV shape)
config {
  type: "view",
  tags: ["raw"],
  assertions: {
    uniqueKey: ["post_id", "target_date", "metric", "period"],
    nonNull: ["post_id", "target_date", "metric", "period"],
    rowConditions: []
  },
  columns: {
    post_id: "The Facebook post ID",
    metric: "The name of the insight metric, e.g. post_clicks, post_media_view",
    period: "The aggregation period the metric value applies to (currently always 'lifetime')",
    value: "The numeric value of the metric",
    target_date: "YYYY-MM-DD date of this insights snapshot",
    ingestion_timestamp: "The timestamp this row was ingested into BigQuery"
  }
}

SELECT
  CAST(post_id AS STRING) AS post_id,
  CAST(metric AS STRING) AS metric,
  CAST(period AS STRING) AS period,
  CAST(value AS INT64) AS value,
  CAST(target_date AS DATE) AS target_date,
  CAST(ingestion_timestamp AS TIMESTAMP) AS ingestion_timestamp
FROM
  `gds-social-data.govuk_facebook.facebook_post_insights`
WHERE post_id IS NOT NULL
