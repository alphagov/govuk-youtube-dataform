
-- A table that contains the raw Facebook video metadata snapshot (one row per video per day)
config {
  type: "view",
  tags: ["raw"],
  assertions: {
    uniqueKey: ["video_id", "target_date"],
    nonNull: ["video_id", "target_date", "page_id"],
    rowConditions: []
  },
  columns: {
    video_id: "The Facebook video ID",
    page_id: "The Facebook page ID that owns the video",
    associated_post_id: "The ID of the Facebook post associated with this video",
    title: "The title of the video",
    description: "The text description of the video",
    created_time: "The timestamp the video was created/published",
    length: "Duration of the video in seconds (unit inferred from observed 1.7-123s range, not confirmed against API docs)",
    target_date: "YYYY-MM-DD date of this metadata snapshot",
    ingestion_timestamp: "The timestamp this row was ingested into BigQuery"
  }
}

SELECT
  CAST(video_id AS STRING) AS video_id,
  CAST(page_id AS STRING) AS page_id,
  CAST(associated_post_id AS STRING) AS associated_post_id,
  CAST(title AS STRING) AS title,
  CAST(description AS STRING) AS description,
  CAST(created_time AS TIMESTAMP) AS created_time,
  CAST(length AS FLOAT64) AS length,
  CAST(target_date AS DATE) AS target_date,
  CAST(ingestion_timestamp AS TIMESTAMP) AS ingestion_timestamp
FROM
  `gds-social-data.govuk_facebook.facebook_videos`
WHERE video_id IS NOT NULL
