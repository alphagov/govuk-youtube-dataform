-- Threads follower demographics at (date, threads_user_id, breakdown, dimension_value) grain.
--
-- Each API category is surfaced as its own typed column (age_group, gender, country_code, city,
-- plus the resolved country_name), generated from threadsDemographicBreakdowns in
-- includes/constants.js so staging and target cannot drift. The grain is one row per dimension
-- value, so exactly one category column is populated per row. It is deliberately not a column per
-- dimension *value*: age and gender have stable closed vocabularies, but city and country only
-- return the top ~45 per pull and that set churns, so a column per value would mean this table's
-- schema changing whenever a city enters or leaves the top 45.
--
-- No clusterBy yet. Clustering here should wait until we know which demographic is actually queried
-- most; the table is small enough that partition pruning alone is fine for now, and there is
-- precedent in tgt_instagram_account_combined for a target with no cluster key.
--
-- The surrogate key hashes the full row grain including breakdown and dimension_value, so it is
-- genuinely unique per row. This differs from tgt_video_demographics, whose key hashes only date
-- and video_id and is not row-unique.
--
-- follower_count is a cumulative total, so follower_count_daily_change is derived from each
-- dimension value's previous snapshot. Because the city and country sets churn, a dimension_value
-- can drop out and come back; LAG skips the dates it was absent, which means
-- days_since_previous_snapshot widens to cover the real gap instead of reporting a misleading
-- one-day change - read the two columns together.
config {
  type: "table",
  tags: ["target","threads"],
  bigquery: {
    partitionBy: "date",
    requirePartitionFilter: true
  },
  columns: {
    demographic_date_id: "Surrogate key: MD5 hash of date-threads_user_id-breakdown-dimension_value, unique at row grain",
    date: "YYYY-MM-DD date of data",
    threads_user_id: "The Threads user ID",
    breakdown: "The demographic dimension this row breaks followers down by: age, city, country or gender",
    dimension_value: "The raw value within the breakdown, e.g. 25-34 for age, F for gender, an ISO country code for country",
    age_group: "The age band this row covers, e.g. 25-34; NULL unless breakdown is age",
    gender: "The gender this row covers, as the raw API code F, M or U; NULL unless breakdown is gender",
    country_code: "The ISO country code this row covers; NULL unless breakdown is country",
    city: "The city this row covers, e.g. 'London, England'; NULL unless breakdown is city",
    country_name: "The country name for country_code, via lookup_country_code_mapping; NULL unless breakdown is country. Listed after city because the category columns are generated in breakdown order",
    follower_count: "The cumulative number of followers in this dimension_value as at the snapshot date, lifetime value",
    follower_count_daily_change: "Change in follower_count since this dimension_value's previous snapshot; NULL on its first appearance, and legitimately negative when followers are lost",
    days_since_previous_snapshot: "Days since this dimension_value's previous snapshot; the window follower_count_daily_change actually covers, and wider than the pull cadence where the value dropped out of the top-N. NULL on first appearance"
  }
}

js {
  const { lifetimeDailyChange, daysSincePreviousSnapshot } = require('includes/utils');
  const { threadsDemographicBreakdowns } = require('includes/constants');
  const demographicPartition = ['threads_user_id', 'breakdown', 'dimension_value'];
}

SELECT
  TO_HEX(MD5(CONCAT(date, '-', threads_user_id, '-', breakdown, '-', dimension_value))) AS demographic_date_id,
  date,
  threads_user_id,
  breakdown,
  dimension_value,
  ${threadsDemographicBreakdowns.map(breakdown => breakdown.column).join(',\n  ')},
  country_name,
  follower_count,
  ${lifetimeDailyChange('follower_count', demographicPartition)},
  ${daysSincePreviousSnapshot(demographicPartition)}
FROM ${ref("stg_threads_follower_demographics")}
