-- We have duplicate metrics like_count, likes_lifetime, comments_count, comments_lifetime
-- the purpose is to check they align, and if not explore why. Once we are certain they align
-- we can remove the media_posts component, as the insights edge will be our approach going forward
--
-- Every insights metric is a cumulative lifetime total, so each carries a matching _daily_change
-- column computed from the post's previous snapshot.
--
-- Both routes to the same numbers are differenced: like_count / comments_count from the media
-- object endpoint, and the insights edge metrics. Comparing like_count_daily_change against
-- likes_lifetime_daily_change is the change-level version of the alignment check this model exists
-- to do.
--
-- The two endpoints are pulled on the same cadence, so a single days_since_previous_snapshot
-- describes both series (checked 2026-09-10: identical 59 snapshot dates, and 1 of 21,777
-- media/date pairs present on the media edge only). It is taken from the insights series. Should
-- the two ever drift apart, the media-derived changes need their own gap column, since a window
-- that describes one series but not the other is worse than no window at all.
config {
  type: "table",
  tags: ["target","instagram"],
  bigquery: {
    partitionBy: "date",
    clusterBy: ["media_type"],
    requirePartitionFilter: true
  },
  columns: {
    media_date_id: "Surrogate key: MD5 hash of date-media_id",
    date: "YYYY-MM-DD date of data",
    media_id: "The Instagram media (post) ID",
    ig_user_id: "The Instagram Business Account ID that owns the media",
    caption: "The caption text of the media",
    media_type: "The underlying media type, e.g. IMAGE, CAROUSEL_ALBUM",
    media_product_type: "The Instagram surface the media was published to (always FEED in this table)",
    media_label: "Human-readable label for this media_type/media_product_type combination",
    permalink: "The public URL of the media",
    published_at: "The timestamp the media was published",
    like_count: "Number of likes on the media as reported by the media object endpoint at snapshot time, this seems to align with the likes_lifetime column",
    comments_count: "Number of comments on the media as reported by the media object endpoint at snapshot time, seems to match comments_lifetime",
    comments_lifetime: "Lifetime count of comments on the media as reported by the insights endpoint, lifetime value",
    likes_lifetime: "Lifetime count of likes on the media as reported by the insights endpoint, lifetime value",
    reach: "Lifetime number of unique accounts that saw the media, lifetime value",
    saved: "Lifetime number of times the media was saved, lifetime value",
    shares: "Lifetime number of times the media was shared, lifetime value",
    total_interactions: "Lifetime sum of likes, comments, saves and shares on the media, lifetime value",
    views: "Lifetime number of views of the media, lifetime value",
    like_count_daily_change: "Change in like_count since this post's previous snapshot; NULL on its first snapshot, and legitimately negative when likes are withdrawn. The media object endpoint's answer to likes_lifetime_daily_change",
    comments_count_daily_change: "Change in comments_count since this post's previous snapshot; NULL on its first snapshot, and legitimately negative when comments are deleted. The media object endpoint's answer to comments_lifetime_daily_change",
    comments_lifetime_daily_change: "Change in comments_lifetime since this post's previous snapshot; NULL on its first snapshot, and legitimately negative when comments are deleted",
    likes_lifetime_daily_change: "Change in likes_lifetime since this post's previous snapshot; NULL on its first snapshot, and legitimately negative when likes are withdrawn",
    reach_daily_change: "Change in reach since this post's previous snapshot; NULL on its first snapshot",
    saved_daily_change: "Change in saved since this post's previous snapshot; NULL on its first snapshot, and legitimately negative when saves are undone",
    shares_daily_change: "Change in shares since this post's previous snapshot; NULL on its first snapshot",
    total_interactions_daily_change: "Change in total_interactions since this post's previous snapshot; NULL on its first snapshot, and legitimately negative when the underlying likes, comments or saves are withdrawn",
    views_daily_change: "Change in views since this post's previous snapshot; NULL on its first snapshot",
    days_since_previous_snapshot: "Days between this snapshot and this post's previous one; the window each _daily_change value actually covers. NULL on the first snapshot"
  }
}

js {
  const { lifetimeDailyChange, daysSincePreviousSnapshot } = require('includes/utils');
  const { stagingAlwaysNullChecks } = require('includes/constants');
  const insightsColumns = stagingAlwaysNullChecks.find(
    check => check.table === 'stg_instagram_media_insights'
  ).columns;
  // Two insights metrics are renamed on the way out so they don't collide with the media object's
  // like_count / comments_count, so the lifetime and the change columns share one alias map.
  const outputAlias = column =>
    ({likes: 'likes_lifetime', comments: 'comments_lifetime'})[column] || column;
}

WITH insights_change AS (
  SELECT
    media_id,
    date,
    ${insightsColumns.join(',\n    ')},
    ${insightsColumns.map(
      column => lifetimeDailyChange(column, ['media_id'])
    ).join(',\n    ')},
    ${daysSincePreviousSnapshot(['media_id'])}
  FROM ${ref("stg_instagram_media_insights")}
),
media_feed AS (
  SELECT *
  FROM ${ref("stg_instagram_media")}
  WHERE media_product_type = 'FEED'
),
media_change AS (
  SELECT
    media_id,
    date,
    like_count,
    comments_count,
    ${lifetimeDailyChange('like_count', ['media_id'])},
    ${lifetimeDailyChange('comments_count', ['media_id'])}
  FROM media_feed
),
GRAIN_SPINE AS (
  SELECT media_id, date FROM media_feed
  UNION DISTINCT
  SELECT i.media_id, i.date
  FROM ${ref("stg_instagram_media_insights")} i
  INNER JOIN (SELECT DISTINCT media_id FROM media_feed) f USING (media_id)
)
SELECT
  TO_HEX(MD5(CONCAT(spine.date, '-', spine.media_id))) AS media_date_id,
  spine.date,
  spine.media_id,
  m.ig_user_id,
  m.caption,
  m.media_type,
  m.media_product_type,
  m.media_label,
  m.permalink,
  m.published_at,
  mc.like_count,
  mc.comments_count,
  ${insightsColumns.map(column => `i.${column} AS ${outputAlias(column)}`).join(',\n  ')},
  mc.like_count_daily_change,
  mc.comments_count_daily_change,
  ${insightsColumns.map(
    column => `i.${column}_daily_change AS ${outputAlias(column)}_daily_change`
  ).join(',\n  ')},
  i.days_since_previous_snapshot
FROM GRAIN_SPINE spine
LEFT JOIN media_feed m USING (media_id, date)
LEFT JOIN media_change mc USING (media_id, date)
LEFT JOIN insights_change i USING (media_id, date)

